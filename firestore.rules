rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Contractor data: only the logged-in owner.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Live attendance links: one document per unguessable token.
    match /shares/{token} {
      // Anyone WITH the token can read ONE active record. No listing, no writing.
      allow get: if resource.data.active == true;
      allow list: if false;
      // Only the contractor who owns it can create, change or disable it.
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
    }
  }
}
